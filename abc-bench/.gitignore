__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# ``automaton`` lives in the sibling monorepo component. Ignore any local
# clone/checkout placed at the component root so it cannot shadow the installed
# ``automaton`` package on ``sys.path`` during imports or test collection.
/automaton/

# Virtual environments
venv/
env/
ENV/

