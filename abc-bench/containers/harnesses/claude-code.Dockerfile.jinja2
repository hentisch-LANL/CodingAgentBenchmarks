FROM {{ parent_image }}

# Claude Code ships a self-contained native binary per platform (it embeds its
# own Node runtime), so the harness layer needs no Node/npm toolchain. We fetch
# that binary directly from the release channel rather than piping
# https://claude.ai/install.sh into bash: the installer's final step runs
# `claude install`, which opens a TUI and hangs with no terminal attached, and
# it installs into $HOME, which is shared and bind-mount-shadowed at run time.
#
# The version is deliberately NOT pinned: this tracks the latest published
# release so benchmark runs exercise current Claude Code behavior, matching the
# codex harness layer. For a frozen CLI, replace the `latest` lookup with a
# literal version (the manifest URL layout is the same).
#
# The published SHA-256 from the release manifest is verified before the binary
# is ever made executable, so a truncated or substituted download fails the
# build instead of a benchmark run.
RUN /bin/bash -lc 'set -euo pipefail; \
    case "$(uname -m)" in \
      x86_64) claude_platform="linux-x64" ;; \
      aarch64|arm64) claude_platform="linux-arm64" ;; \
      *) echo "unsupported architecture for claude code: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    if ldd /bin/ls 2>&1 | grep -q musl; then claude_platform="${claude_platform}-musl"; fi; \
    base_url="https://downloads.claude.ai/claude-code-releases"; \
    mkdir -p /opt/claude-code/bin /opt/claude-code/build-info; \
    claude_version="$(curl -fsSL --retry 5 --retry-delay 3 --retry-connrefused "${base_url}/latest")"; \
    if [[ ! "${claude_version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then \
      echo "claude code release channel returned an unexpected version: ${claude_version}" >&2; exit 1; \
    fi; \
    curl -fsSL --retry 5 --retry-delay 3 --retry-connrefused \
      -o /opt/claude-code/build-info/manifest.json \
      "${base_url}/${claude_version}/manifest.json"; \
    claude_sha="$(python -c "import json,sys; print(json.load(open(sys.argv[1]))[\"platforms\"][sys.argv[2]][\"checksum\"])" \
      /opt/claude-code/build-info/manifest.json "${claude_platform}")"; \
    curl -fsSL --retry 5 --retry-delay 3 --retry-connrefused \
      -o /opt/claude-code/bin/claude \
      "${base_url}/${claude_version}/${claude_platform}/claude"; \
    echo "${claude_sha}  /opt/claude-code/bin/claude" | sha256sum -c -; \
    chmod 0755 /opt/claude-code/bin/claude; \
    ln -s /opt/claude-code/bin/claude /usr/local/bin/claude; \
    printf "%s\n" "${claude_version}" > /opt/claude-code/build-info/release-channel-version.txt; \
    printf "%s\n" "${claude_platform}" > /opt/claude-code/build-info/platform.txt; \
    sha256sum /opt/claude-code/bin/claude > /opt/claude-code/build-info/binary.sha256'

# Fail the build (rather than a benchmark run) if the binary is unusable, and
# archive the resolved version/help for run provenance. HOME is redirected to a
# scratch dir because `claude --version` writes user state on first run, and the
# image's HOME is a shared, run-time-mutable path.
RUN /bin/bash -lc 'set -euo pipefail; \
    build_home="$(mktemp -d)"; \
    which claude; \
    HOME="${build_home}" claude --version | tee /opt/claude-code/build-info/version.txt; \
    HOME="${build_home}" claude --help > /opt/claude-code/build-info/help.txt; \
    rm -rf "${build_home}"'

WORKDIR /workspace
